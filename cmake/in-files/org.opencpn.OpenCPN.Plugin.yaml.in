id: org.opencpn.OpenCPN.Plugin.${PACKAGE}
runtime: org.opencpn.OpenCPN
runtime-version: ${RUNTIME_VERSION}
sdk: org.freedesktop.Sdk//${SDK_VER}
build-extension: true
separate-locales: false
appstream-compose: false
${finish_args}
${build_options}

cleanup:
  - /include
  - /lib/*.a
  - /lib/*.la
  - /lib/cmake
  - /lib/pkgconfig
  - /lib64/*.a
  - /lib64/*.la
  - /lib64/cmake
  - /lib64/objects-*
  - /lib64/pkgconfig

modules:
${flatpak_extra_modules}
  - name: ${PACKAGE}
    no-autogen: true
    buildsystem: cmake
    builddir: true
    config-opts:
        - -DCMAKE_INSTALL_PREFIX=/app/extensions/${PACKAGE}
        - -DOCPN_FLATPAK_BUILD=ON
        - -DOFFLINETIDES_STATIC_RUNTIME_DEPS=ON
        - -DXTIDAL_STANDALONE_API=ON
        - -DXTIDAL_BUILD_AUTHORING_TOOLS=OFF
        - -DOCPN_BUILD_TEST=OFF
        - -DOCPN_TARGET=${OCPN_TARGET}
        - -DSDK_VER=${SDK_VER}
        - -DWX_VER=${WX_VER}
    build-options:
        env:
          PKG_CONFIG_PATH: /app/extensions/${PACKAGE}/lib/pkgconfig
          CMAKE_PREFIX_PATH: /app/extensions/${PACKAGE}
        cflags: -fPIC
        cxxflags: -fPIC -DFLATPAK
        strip: true
    sources:
       - type: git
         # Build the exact authenticated checkout.  This keeps validation
         # usable while the xWeatherRouting repository is private and avoids
         # a second unauthenticated network clone inside flatpak-builder.
         url: file://${PROJECT_SOURCE_DIR}
         ${GIT_BRANCH_OR_TAG}: ${GIT_REPOSITORY_ITEM}
